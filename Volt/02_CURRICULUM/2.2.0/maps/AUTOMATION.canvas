    {
      "id": "file-77ecc3008af375a50048a549",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_AUT_03.md",
      "x": 5680,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: שלב ה־AI החזיר טקסט חופשי במקום המבנה שהוגדר. מה צריך לקרות לפני כתיבה ל־CRM?"
