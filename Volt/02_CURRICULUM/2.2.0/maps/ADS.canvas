    {
      "id": "group-b3e1d282f230c12577f296c4",
      "type": "group",
      "x": 5656,
      "y": 250,
      "width": 1370,
      "height": 1030,
      "label": "שאלות לחיזוק ההבנה · טיוטות מסומנות ברשומות",
      "color": "2"
    },
    {
      "id": "file-8949653647bd323a87600c71",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_ADS_01.md",
      "x": 5680,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: קמפיין הוציא כסף אך נרשמו בו אפס המרות. איך צריך להציג את ה־CPA לפי נוסחת עלות חלקי המרות?"
    },
    {
      "id": "file-86a2f7197ae7cd962e1b0aa5",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_ADS_02.md",
      "x": 6360,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: אותו קובץ נתוני קמפיינים מיובא שוב. מה צריך להבטיח כדי לא לנפח את ההוצאות בדוח?"
    },
    {
      "id": "file-bfe97dc01982651419180ea0",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_ADS_03.md",
      "x": 5680,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: בניסוי מודעה הוחלפו יחד הקהל, המסר והתמונה. למה קשה לפרש את השינוי בתוצאה?"
    },
    {
      "id": "file-38f0664aa394d340ae94cc68",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_ADS_04.md",
      "x": 6360,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: פניות מגיעות מטופס דף הנחיתה, אבל אירוע ההמרה לא נרשם. מה צריך לבדוק לפני מסקנה שהקמפיין נכשל?"
    },
    {
      "id": "file-646954f055a44fcb25d3aa76",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_ADS_05.md",
      "x": 5680,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: העוזר ממליץ להעלות תקציב, אך אין אישור לשינוי. מהו המצב הנכון של ההמלצה?"
    },
    {
      "id": "file-bc3a089291ed0b3c0ab2e64c",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_ADS_06.md",
      "x": 6360,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: בדוח המסכם נכתב שינוי תקציב מוצע בלי שבוצע בפועל. כיצד צריך לתעד אותו?"
    },
    {
      "id": "file-88f2e8af7d4a18cf9c6ade6b",
      "type": "file",
      "file": "02_CURRICULUM/system-quizzes/1.0.0/QUIZ_EVIDENCE_NEXT_STEP.md",
      "x": 5680,
      "y": 1020,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#לפני שמגישים · שאלה קצרה לתרגול"
    },
    {
      "id": "group-5db057545062099b5ec25246",
      "type": "group",
      "x": 7076,
      "y": 250,
      "width": 1370,
      "height": 2180,
      "label": "קשרים נוספים לפרק ולשיעורים",
      "color": "6"
    },
    {
      "id": "file-b36640071cb2134abf5dd905",
      "type": "file",
      "file": "01_AGENTS/Agent-Automation-Engineer.md",
      "x": 7100,
      "y": 330,
