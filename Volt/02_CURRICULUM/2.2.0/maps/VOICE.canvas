    {
      "id": "group-d9c305d90591be181e63fcd2",
      "type": "group",
      "x": 5656,
      "y": 250,
      "width": 1370,
      "height": 1030,
      "label": "שאלות לחיזוק ההבנה · טיוטות מסומנות ברשומות",
      "color": "2"
    },
    {
      "id": "file-e500ff40e268c006dbcbc194",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_VOI_01.md",
      "x": 5680,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: מספר הזמנה בתמלול נשמע חשוד. מה מאפשר לבדוק מה באמת נאמר?"
    },
    {
      "id": "file-2fb257e6e756acaf1378fd99",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_VOI_02.md",
      "x": 6360,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: סיכום השיחה כולל התחייבות להנחה שלא נאמרה בשיחה. מה נכון לעשות לפני הפיכת הסיכום למשימות?"
    },
    {
      "id": "file-db5b3dca522cd9b0c06e76ae",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_VOI_03.md",
      "x": 5680,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: שם מוצר נשמע שגוי בהקראה של העוזר. איך מאתרים את מקור התקלה בתהליך הקולי המדורג?"
    },
    {
      "id": "file-5977f6d6e70092e245444087",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_VOI_04.md",
      "x": 6360,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: משתמש קוטע תשובה קולית ומשנה את בקשתו בזמן שכלי עובד. מה צריך לנהל לצד הדיבור?"
    },
    {
      "id": "file-0819e15878775c1bcfc32f1a",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_VOI_05.md",
      "x": 5680,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: העוזר הציע שעה לפגישה, אבל היומן עדיין לא אישר שהפגישה נשמרה. איך נכון להציג את המצב?"
    },
    {
      "id": "file-1b277315e2b57b390921f8a1",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_VOI_06.md",
      "x": 6360,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: עוזר קולי עבר שיחת הדגמה אחת בלי תקלה. מה חסר כדי להעריך את איכותו העסקית?"
    },
    {
      "id": "file-88f2e8af7d4a18cf9c6ade6b",
      "type": "file",
      "file": "02_CURRICULUM/system-quizzes/1.0.0/QUIZ_EVIDENCE_NEXT_STEP.md",
      "x": 5680,
      "y": 1020,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#לפני שמגישים · שאלה קצרה לתרגול"
    },
    {
      "id": "group-31c88687247d807a02570540",
      "type": "group",
      "x": 7076,
      "y": 250,
      "width": 1370,
      "height": 2640,
      "label": "קשרים נוספים לפרק ולשיעורים",
      "color": "6"
