    {
      "id": "group-3cf100e8357033f087d59fe3",
      "type": "group",
      "x": 5656,
      "y": 250,
      "width": 1370,
      "height": 1030,
      "label": "שאלות לחיזוק ההבנה · טיוטות מסומנות ברשומות",
      "color": "2"
    },
    {
      "id": "file-009bf48052c83999dced69bd",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_BIZ_01.md",
      "x": 5680,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: לקוח אומר רק ״אנחנו רוצים AI״. מה צריך לברר בפגישת האפיון לפני בחירת מוצר?"
    },
    {
      "id": "file-cdb64e1bcb175d1657acf887",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_BIZ_02.md",
      "x": 6360,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: פיילוט נראה בעל ערך גבוה, אבל הנתונים הנדרשים אינם זמינים. מה נכון להביא בחשבון בבחירתו?"
    },
    {
      "id": "file-2677c84c117fe85a0f091fda",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_BIZ_03.md",
      "x": 5680,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: הלקוח מוסיף דרישה באמצע הפיילוט. איך צריך להתייחס לשינוי בהיקף העבודה?"
    },
    {
      "id": "file-585b59d3765b2a980d2cc82c",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_BIZ_04.md",
      "x": 6360,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: מערכת הלקוח עדיין תלויה במפתח גישה של ספק השירות. מה צריך להבהיר ולתכנן במסירה?"
    },
    {
      "id": "file-ca8e2424c88cb31fc9d0ceff",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_BIZ_05.md",
      "x": 5680,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: הפיילוט פועל ב־Shadow Mode. מה המערכת עושה במצב הזה?"
    },
    {
      "id": "file-3b7d39a031e62c597245f8fd",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_BIZ_06.md",
      "x": 6360,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: הלקוח מבקש להרחיב את האוטונומיה מעבר למה שנבדק בהדגמה. מהו הצעד המתאים?"
    },
    {
      "id": "file-88f2e8af7d4a18cf9c6ade6b",
      "type": "file",
      "file": "02_CURRICULUM/system-quizzes/1.0.0/QUIZ_EVIDENCE_NEXT_STEP.md",
      "x": 5680,
      "y": 1020,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#לפני שמגישים · שאלה קצרה לתרגול"
