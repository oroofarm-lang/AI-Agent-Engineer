    {
      "id": "group-60a9f0c5955e7eeaf3da0af9",
      "type": "group",
      "x": 5656,
      "y": 250,
      "width": 1370,
      "height": 1030,
      "label": "שאלות לחיזוק ההבנה · טיוטות מסומנות ברשומות",
      "color": "2"
    },
    {
      "id": "file-73e5605fe2e26a88a7b73998",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_WEB_01.md",
      "x": 5680,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: בטופס פנייה מופיע ״הושלם״ מיד לאחר שהמשימה נכנסה לתור. מהו התיקון המתאים למסע המשתמש?"
    },
    {
      "id": "file-761e793dec837c9e08300e6a",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_WEB_02.md",
      "x": 6360,
      "y": 330,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: ממשק בעברית מוגדר כ־RTL. כיצד צריך להתייחס לקוד ולשימוש במקלדת?"
    },
    {
      "id": "file-db61d5913c913426c15ffe05",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_WEB_03.md",
      "x": 5680,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: כרטיס בדף שנוצר בעזרת AI נראה טוב במחשב אך חורג מרוחב הטלפון. מה נדרש כדי להשלים את הבנייה?"
    },
    {
      "id": "file-1a6d34abaa86ea03ae1a38f6",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_WEB_04.md",
      "x": 6360,
      "y": 560,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: הטופס נשלח, הרשת נותקה, והמשתמש מנסה שוב. מה עוזר למנוע יצירת שתי פניות?"
    },
    {
      "id": "file-c74a0233d7d96099d7fc251d",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_WEB_05.md",
      "x": 5680,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: דוח אוטומטי על האתר נראה תקין. איזו בדיקה עסקית עדיין צריך לבצע לפני פרסום?"
    },
    {
      "id": "file-0f04d5800b20b7707a918fea",
      "type": "file",
      "file": "02_CURRICULUM/quiz-banks/1.0.0-draft/QUIZ_WEB_06.md",
      "x": 6360,
      "y": 790,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#בדיקת הבנה: העוזר באתר מציג תשובות קבועות לצורכי הדגמה. כיצד נכון לתאר אותו למשתמש?"
    },
    {
      "id": "file-88f2e8af7d4a18cf9c6ade6b",
      "type": "file",
      "file": "02_CURRICULUM/system-quizzes/1.0.0/QUIZ_EVIDENCE_NEXT_STEP.md",
      "x": 5680,
      "y": 1020,
      "width": 640,
      "height": 180,
      "color": "2",
      "subpath": "#לפני שמגישים · שאלה קצרה לתרגול"
    },
    {
      "id": "group-3005f1c293a9948fa1a7a265",
      "type": "group",
      "x": 7076,
      "y": 250,
      "width": 1370,
      "height": 2410,
      "label": "קשרים נוספים לפרק ולשיעורים",
      "color": "6"
    },
    {
