OPENAI_API_KEY=
AI_MODEL=
DATABASE_URL=.data/learning.sqlite

# Loopback is the only mode allowed without mail. Run npm run db:setup first.
BETTER_AUTH_URL=http://127.0.0.1:3000
# At least 32 random characters. Local setup creates .data/auth-secret if omitted.
BETTER_AUTH_SECRET=
# Public deployments require HTTPS and transactional email.
SMTP_URL=
# Alternatively, use explicit SMTP fields (Gmail testing: smtp.gmail.com, 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only verified accounts listed here can access /admin. Never use the first signup.
ADMIN_EMAILS=
# Immutable, reviewed curriculum releases; keep this private persistent directory outside public assets.
CURRICULUM_AUDITOR_DIR=.data/curriculum-auditor
QUIZ_REVIEW_DIR=.data/quiz-releases
# Writable public export root. Never supplied by a browser; tests use their own isolated Vault.
VAULT_EXPORT_DIR=Volt
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=

# Gmail API OAuth alternative when app passwords are unavailable. Sending scope only.
MAIL_PROVIDER=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
